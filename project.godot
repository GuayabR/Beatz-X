; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Beatz! X."
config/name_localized={
"ja_JP": "ビーツ！ X。"
}
config/description="Beatz! X.
VISUALIZE. YOUR RHYTHM.
By GuayabR."
config/version="1.6.0"
config/tags=PackedStringArray("beatz", "demo", "game", "rhythm")
run/main_scene="uid://4puupvbpclaw"
config/quit_on_go_back=false
config/features=PackedStringArray("4.5", "Forward Plus")
run/flush_stdout_on_print.debug=false
boot_splash/image="uid://byed1ljwunwsj"
config/icon="uid://6cvc1r2mkha7"

[audio]

buses/default_bus_layout="uid://rghy1w6xgfll"
driver/driver=""
driver/output_latency=1

[autoload]

DiscordRPCLoader="*res://addons/discord-rpc-gd/nodes/discord_autoload.gd"
Gamepad_Cursor="*res://addons/GamepadCursor/gamepad_cursor.gd"
General="*res://Scenes/general.gd"
Settings="*res://Scenes/settings.gd"
Beatz="*res://beatz.gd"
SceneLoader="*res://Scenes/scene_loader.gd"
Id3TagParser="*res://addons/Id3TagParser/improved_mp3id3_tag_parser.gd"
EpicUserDataStore="*res://Scenes/epicuserdatastore.gd"
AchieveMan="*res://Scenes/achieve_man.gd"
EOSGRuntime="*res://addons/epic-online-services-godot/runtime.gd"
HPlatform="*res://addons/epic-online-services-godot/heos/hplatform.gd"
HAuth="*res://addons/epic-online-services-godot/heos/hauth.gd"
HAchievements="*res://addons/epic-online-services-godot/heos/hachievements.gd"
HFriends="*res://addons/epic-online-services-godot/heos/hfriends.gd"
HStats="*res://addons/epic-online-services-godot/heos/hstats.gd"
HLeaderboards="*res://addons/epic-online-services-godot/heos/hleaderboards.gd"
HLobbies="*res://addons/epic-online-services-godot/heos/hlobbies.gd"
HP2P="*res://addons/epic-online-services-godot/heos/hp2p.gd"
HSessions="*res://addons/epic-online-services-godot/heos/hsessions.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="viewport"
display_server/driver.windows="windows"
mouse_cursor/stretch/aspect="keep"
mouse_cursor/stretch/mode="canvas_items"
mouse_cursor/fullsize=true
mouse_cursor/name_localized={
"ja_JP": "ビーツ！ X"
}
mouse_cursor/version="Internal 1.4.2 Public 1.0.3"

[dotnet]

project/assembly_name="Beatz! X."

[editor]

movie_writer/video_quality=1.0
movie_writer/ogv/audio_quality=1.0
movie_writer/ogv/encoding_speed=2
naming/node_name_casing=2

[editor_plugins]

enabled=PackedStringArray("res://addons/GamepadCursor/plugin.cfg", "res://addons/Id3TagParser/plugin.cfg", "res://addons/discord-rpc-gd/plugin.cfg", "res://addons/epic-online-services-godot/plugin.cfg", "res://addons/gde_gozen/plugin.cfg", "res://addons/markdownlabel/plugin.cfg", "res://addons/taskbar_progress/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom_font="uid://6jhh1vyac4f4"

